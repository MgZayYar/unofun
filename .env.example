# Copy to .env and fill in your values. Never commit a real .env.

# REQUIRED in production — long random string
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Translation for dubbing (OpenAI). TTS itself is free via Edge TTS.
OPENAI_API_KEY=

# Speech-to-text model (faster-whisper): tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS provider: edge (free, default) | openai
TTS_PROVIDER=edge

# Free trial credit, in dubbing minutes per new account
FREE_TRIAL_MINUTES=30

# Max ingest sizes (bytes)
MAX_UPLOAD_BYTES=2147483648
MAX_URL_DOWNLOAD_BYTES=2147483648

# Standalone worker poll interval (seconds)
WORKER_POLL_INTERVAL=2.0
